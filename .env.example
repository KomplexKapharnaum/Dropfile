# Where uploaded media is stored on disk (one folder per project slug)
UPLOAD_PATH     = "/srv/seafile-sync/Dropfile"

# Max upload size, in MB
UPLOAD_SIZE     = 300

# HTTP port for the app (Socket.IO shares it)
FRONTEND_PORT   = 5000

# JSON config store location (projects / players / uploads manifest)
DATA_PATH       = "./data"

# Public base URL used to build QR codes and share links (no trailing slash).
# Falls back to the browser origin if empty.
PUBLIC_URL      = "https://drop.example.org"

# Admin password (HTTP Basic, any username). If empty, admin is OPEN.
ADMIN_PASSWORD  = "change-me"

# --- Phase 2 (WebRTC camera takeover) — self-hosted coturn ---
# coturn runs on the public-facing box (see extra/turnserver.conf + README).
# lib/turn.js signs short-lived ICE credentials; TURN_SECRET MUST equal coturn's
# static-auth-secret. Leave unset to disable TURN.
# TURN_HOST     = "turn.example.org"
# TURN_SECRET   = "same-hex-as-static-auth-secret"   # openssl rand -hex 32
# TURN_TTL      = 43200                                # optional, seconds (12h)

# --- KXKM relay forwarding (optional) ---
# Base URL of the KXKM relay app. Per-scene relay toggles in the admin decide
# which scenes forward their incoming text / images there. Unset = off.
# RELAY_URL     = "https://relay.example.org"
